<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (API 26+) — picked up automatically over the flat
  mipmap-*/ic_launcher.png fallback below API 26. Two layers per the icon
  spec: background is a plain color (@color/ic_launcher_background, warm
  paper — not a drawable file), foreground is the mark alone on
  transparency at 47% of the canvas (see mipmap-*/ic_launcher_foreground.png,
  generated from assets/android/ic_launcher_foreground.png). Monochrome is
  the same geometry as a flat silhouette, tinted by the OS on Android 13+
  themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
