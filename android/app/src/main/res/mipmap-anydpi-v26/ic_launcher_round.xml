<?xml version="1.0" encoding="utf-8"?>
<!-- Same layers as ic_launcher.xml — the OS applies the circular mask
 itself; the mark's ink sits inside the adaptive-safe circle at 47%, so no
 separate round-specific art is needed. See ic_launcher.xml for the layer
 breakdown. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
